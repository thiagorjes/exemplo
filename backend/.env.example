# Copie para .env antes de rodar.
PORT=3001
DATABASE_PATH=./data/app.db
SESSION_SECRET=troque-este-valor-em-cada-ambiente
# Janela de inatividade antes da sessão expirar (RN-004). Padrão de produção: 300000 (5min).
# Ambiente de e2e usa 30000 (30s) — ver e2e/.env.example.
SESSION_IDLE_TIMEOUT_MS=300000
