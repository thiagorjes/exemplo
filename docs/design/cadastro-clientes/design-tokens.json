  "spacing": {
    "base": 16,
    "scale": { "sm": 6, "md": 8, "lg": 12, "2xl": 20, "3xl": 24, "4xl": 32, "5xl": 40, "6xl": 44, "7xl": 64, "8xl": 80 }
