  "typography": {
    "fontFamily": { "sans": ["Inter", "var(--font-inter)", "ui-sans-serif", "system-ui", "sans-serif"] },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
    "fontSize": {
