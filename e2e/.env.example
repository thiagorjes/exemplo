# Copie para .env antes de rodar a suíte. Valores devem bater com backend/.env e frontend/.env
# do ambiente local em que a suíte vai rodar.
BASE_URL=http://localhost:3000
API_URL=http://localhost:3001
SEED_ADMIN_CPF=11111111111
SEED_ADMIN_SENHA=senha123
# Tem que ser EXATAMENTE o mesmo valor de SESSION_IDLE_TIMEOUT_MS no backend (RN-004) —
# os testes de expiração de sessão (SCN-001.3, SCN-009.2) esperam esse tempo real antes de
# conferir o efeito. Decisão do demandante em 2026-10-22: 30s no ambiente de e2e, não os 5min
# de produção, para a suíte headed não ficar arrastada.
SESSION_IDLE_TIMEOUT_MS=30000
